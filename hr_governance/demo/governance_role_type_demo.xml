<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="role_type_ceo" model="governance.role.type">
        <field name="name">CEO</field>
        <field name="type">template</field>
        <field
            name="purpose"
        >Lead the organization with strategic vision and ensure sustainable growth</field>
        <field
            name="authority"
        >Final decision-making authority on all organizational matters</field>
        <field
            name="expectation"
        >Drive innovation, maintain stakeholder relationships, and ensure organizational success</field>
        <field name="color">1</field>
        <field name="is_steering_role">True</field>
        <field name="enable_edit_circle">True</field>
    </record>
